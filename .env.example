# BOSS Environment Configuration (Copy to .env for deployment; never commit .env)
BOSS_APP_NAME="BOSS — Business Operating Smart System"
BOSS_ENV="development"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://boss:change_me@localhost:5432/boss"
DATABASE_URL="sqlite:///./boss.db"

# Security (generate 64-char hex secret in production)
BOSS_SECRET_KEY="CHANGE_ME_TO_64_HEX_CHARS_IN_PRODUCTION"
BOSS_SESSION_TTL_HOURS=12
BOSS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local Storage Directory
BOSS_STORAGE_DIR="./storage_data"
BOSS_BACKUP_DIR="./backups"

# Business Defaults (India Water Pumps & Spares)
BOSS_BUSINESS_NAME="AquaFlow Pumps & Spares India"
BOSS_HOME_STATE="DL"
BOSS_GSTIN="07AABCA1234F1Z5"

# External Integrations (Leave blank until authorized; BOSS accurately marks them NOT_CONFIGURED)
AMAZON_SP_CLIENT_ID=""
AMAZON_SP_CLIENT_SECRET=""
AMAZON_SP_REFRESH_TOKEN=""
FLIPKART_APP_ID=""
FLIPKART_APP_SECRET=""
BUSY_BRIDGE_ENDPOINT=""
WHATSAPP_OTP_PROVIDER_URL=""
WHATSAPP_OTP_API_TOKEN=""

